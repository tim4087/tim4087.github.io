---
# Search index: generated at build time, fetched and filtered by the
# browser (see _includes/search.html). No server-side search needed.
---
[
{% for post in site.posts -%}
{
  "title": {{ post.title | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "lang": {{ post.lang | default: "en" | jsonify }},
  "date": {{ post.date | date: "%b %-d, %Y" | jsonify }},
  "excerpt": {{ post.excerpt | strip_html | strip_newlines | strip | jsonify }},
  "content": {{ post.content | strip_html | split: "
" | join: " " | strip | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor -%}
]
